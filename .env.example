OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
EMBEDDING_MODEL=nomic-embed-text
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=work_instructions
DOCUMENTS_PATH=/documents
EMBEDDING_BATCH_SIZE=16
CHUNK_SIZE=1400
CHUNK_OVERLAP=250
# Local execution only; Compose uses its shared volume at /state/locks.
INDEX_LOCK_PATH=/tmp/instruct-locks
MIN_SCORE=0.35
TOP_K=4
RETRIEVAL_CANDIDATES=24
CONTEXT_MAX_CHARS=8000
# Local execution only; Compose uses /state/lexical.
LEXICAL_INDEX_PATH=./data/lexical
# Bornes prudentes pour qwen3:8b; une seule génération, sans réflexion étendue.
# Les passages entiers doivent aussi tenir dans le budget UTF-8 conservateur.
MAX_CONTEXT_CHARS=3200
MAX_PASSAGE_CHARS=1400
MAX_ANSWER_CHARS=1600
MAX_RESPONSE_CHARS=6000
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=768
VITE_API_URL=http://localhost:8000
