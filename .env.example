OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
EMBEDDING_MODEL=nomic-embed-text
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=work_instructions
DOCUMENTS_PATH=/documents
EMBEDDING_BATCH_SIZE=16
CHUNK_SIZE=1400
CHUNK_OVERLAP=250
# Local execution only; Compose uses its shared volume at /state/locks.
INDEX_LOCK_PATH=/tmp/instruct-locks
MIN_SCORE=0.35
TOP_K=4
# One origin for browser and API. HTTPS required for any non-loopback host.
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
STATE_PATH=/state
SESSION_SECONDS=28800
LOGIN_ATTEMPTS=5
AUDIT_RETENTION_DAYS=90
MAX_PDF_BYTES=52428800
# For docker-compose.lan.yml only:
# APP_ORIGIN=https://instruct.example.internal
# LAN_BIND_IP=192.168.1.20


# Index lexical local, reconstruit depuis les passages Qdrant lors de la restauration.
LEXICAL_INDEX_PATH=/state/lexical
DOCUMENT_STATE_PATH=/state/document-manager

RETRIEVAL_CANDIDATES=24
CONTEXT_MAX_CHARS=8000
MAX_CONTEXT_CHARS=3200
MAX_PASSAGE_CHARS=1400
MAX_ANSWER_CHARS=1600
MAX_RESPONSE_CHARS=6000
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=768

# Modes : auto détecte version + capacités + template du modèle configuré.
# boolean = confirmation explicite d’un modèle à think true/false si métadonnées
# absentes; none = confirmation d’un modèle SANS raisonnement (Rapide uniquement).
# Redémarrer le backend après changement de modèle, template ou version Ollama.
OLLAMA_THINK_SUPPORT=auto
# Budget Réflexion TOTAL (raisonnement + JSON final), distinct du budget Rapide ci-dessus.
OLLAMA_REFLECTION_NUM_PREDICT=1536
# Secondes; 0 décharge le modèle après la requête. Embeddings et génération.
OLLAMA_KEEP_ALIVE_SECONDS=120
# Délai total d’une question (file + recherche + génération), maximum 240 s.
ASK_TIMEOUT_SECONDS=180
ASK_CONCURRENCY=1
ASK_QUEUE_SIZE=2
ASK_QUEUE_TIMEOUT_SECONDS=15
# Limites du service Ollama, transmises par Compose (un seul processus backend).
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_MAX_QUEUE=2
